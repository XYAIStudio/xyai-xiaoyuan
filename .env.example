XYAI_FREEOS_URL=http://127.0.0.1:8088
XYAI_OPENXYOS_URL=http://127.0.0.1:3000
XYAI_GROKBOT_URL=http://127.0.0.1:1340
# XYAI Studio 仍无远程对话 API；仅作端口探测。
XYAI_STUDIO_URL=http://127.0.0.1:5173

