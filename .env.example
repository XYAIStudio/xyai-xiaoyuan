# Optional Vite host used by `tauri dev` on a remote machine.
# TAURI_DEV_HOST=127.0.0.1

# --- Live 联调（本机后端，密钥勿提交）---
# 优先 FreeOS :8088。npm run doctor 会先检查该地址。
# openXYOS :3000 未开可忽略，不必改默认。
XYAI_FREEOS_URL=http://127.0.0.1:8088
XYAI_OPENXYOS_URL=http://127.0.0.1:3000
XYAI_GROKBOT_URL=http://127.0.0.1:1340
# XYAI Studio 仍无远程对话 API；仅作端口探测。
XYAI_STUDIO_URL=http://127.0.0.1:5173

# 模拟网关（npm run mock:backends）
# XYAI_FREEOS_URL=http://127.0.0.1:18088
# XYAI_OPENXYOS_URL=http://127.0.0.1:13000
# XYAI_GROKBOT_URL=http://127.0.0.1:11340
