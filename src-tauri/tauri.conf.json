{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XYAI精灵小元",
  "version": "0.1.0",
  "identifier": "com.xyai.xiaoyuan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "小元",
        "width": 180,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": true
      },
      {
        "label": "chat",
        "title": "小元对话",
        "width": 420,
        "height": 520,
        "minWidth": 300,
        "minHeight": 240,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 560,
        "height": 620,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "XYAI",
    "category": "Utility",
    "shortDescription": "XYAI精灵小元",
    "longDescription": "XYAI 官方桌面伴侣：透明置顶桌宠、紧凑对话，可插拔对接 XYAIStudio 各独立后端。",
    "copyright": "Copyright © 2026 XYAI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMkRFOTEyMjUwRDU0QzIKUldUQ1ZBMGxFdWt0MjA0US9Fd3pBN1V5RDhuN2R5YlBVVjJuTnIyaHlNYnN1by8xSmt0cmcwNlUK",
      "endpoints": [
        "https://github.com/XYAIStudio/xyai-xiaoyuan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
